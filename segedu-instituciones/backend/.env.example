# Copie este archivo como .env y complete los valores reales
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_mysql
DB_PASSWORD=clave_mysql
DB_NAME=segedu_instituciones
# Cadena aleatoria larga (obligatoria). Ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=7d
# Dominio público del sistema, por ejemplo https://segedu.miinstituto.edu.bo
FRONTEND_URL=

# Correo saliente para las solicitudes de permiso (opcional)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SEGEDU <notificaciones@midominio.com>"

# ─── Multi-institución por subdominio (opcional) ──────────────────────────────
# Con MULTI_INSTITUCION=1 cada colegio/universidad tiene su subdominio y su propia base:
#   segedu.chakuy.online              → instalación por defecto (DB_NAME de arriba)
#   plataforma.segedu.chakuy.online   → panel de Chakuy para crear instituciones (superadmin)
#   colegio-x.segedu.chakuy.online    → base de "colegio-x"
MULTI_INSTITUCION=0
BASE_DOMINIO=segedu.chakuy.online
PLATAFORMA_SUBDOMINIO=plataforma
# Base con el registro de instituciones y superadmins. En cPanel créela una vez (con su prefijo)
# y asígnele el usuario DB_USER con todos los privilegios.
PLATAFORMA_DB_NAME=cpusuario_segedu_plataforma
# Clave para cifrar las contraseñas de las bases de cada institución. Larga y aleatoria; NO la cambie
# después de crear instituciones (no se podrían descifrar).
PLATAFORMA_SECRET=
# Solo si hay un proxy delante que envía X-Forwarded-Host (en desarrollo se confía siempre)
CONFIAR_PROXY=0

# Cómo se crean base, usuario y subdominio: cpanel (producción) o local (desarrollo, CREATE DATABASE directo)
PROVISION_MODO=cpanel
# cPanel → Seguridad → Administrar tokens de API. El token necesita acceso a MySQL y Subdominios.
CPANEL_HOST=segedu.chakuy.online
CPANEL_PUERTO=2083
CPANEL_USUARIO=cpusuario
CPANEL_TOKEN=
# Dominio del que cuelgan los subdominios y carpeta (relativa al home) donde vive la app Node
CPANEL_DOMINIO_RAIZ=segedu.chakuy.online
CPANEL_DIR_SUBDOMINIOS=segedu
# Ruta al esquema que se carga en cada base nueva (si no está en ../database/schema.sql)
ESQUEMA_SQL=
# Conexiones por institución (hosting compartido: mantener bajo)
INSTITUCION_POOL_LIMITE=3
# Solo en desarrollo: prefijo de las bases locales
LOCAL_DB_PREFIJO=segedu_inst_
