# Copie este archivo como .env y complete los valores reales
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_mysql
DB_PASSWORD=clave_mysql
DB_NAME=segedu_instituciones
# Cadena aleatoria larga (obligatoria). Ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=7d
# Dominio público del sistema, por ejemplo https://segedu.miinstituto.edu.bo
FRONTEND_URL=

# Correo saliente para las solicitudes de permiso (opcional)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SEGEDU <notificaciones@midominio.com>"
