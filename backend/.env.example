# Copia este archivo como .env y completa los valores reales
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpanelusuario_dbuser
DB_PASSWORD=tu_password_seguro
DB_NAME=cpanelusuario_segedu
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_larga_y_segura
JWT_EXPIRES=7d
FRONTEND_URL=https://tudominio.com
ANTHROPIC_API_KEY=sk-ant-tu_api_key_de_anthropic

# Videotutoriales en una unidad compartida de Google Drive.
# Los dos primeros valores salen de la clave JSON de la cuenta de servicio (client_email y private_key).
GOOGLE_SERVICE_ACCOUNT_EMAIL=cazcarraga@chakuy.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID de la unidad: la parte final de su URL, drive.google.com/drive/folders/<ID>
GOOGLE_SHARED_DRIVE_ID=

# Correo saliente para las solicitudes de permiso (Gmail de Google Workspace).
# SMTP_PASS es una contraseña de aplicación de esa cuenta, no su contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=notificaciones@chakuy.com
SMTP_PASS=contraseña_de_aplicacion_sin_espacios
SMTP_FROM="SEGEDU <notificaciones@chakuy.com>"
